@prefix cro: <https://customer-review-ontology.example/ontology#> .

cro:NET_15 a cro:PaymentTerms .
cro:NET_30 a cro:PaymentTerms .
cro:NET_45 a cro:PaymentTerms .
cro:NET_60 a cro:PaymentTerms .

cro:customer-1001 a cro:Customer ;
  cro:customerNumber 1001 ;
  cro:customerName "Acme Systems Inc." ;
  cro:arBalance 125000.00 ;
  cro:pastDueAmount 15000.00 ;
  cro:averageDaysToPay 28 ;
  cro:paymentTerms cro:NET_30 ;
  cro:restrictedStatus cro:NotRestricted .

cro:NET_30_PAST_DUE_MAX_5 a cro:RatioPolicy ;
  cro:scopePaymentTerms cro:NET_30 ;
  cro:maxPastDueRatio 0.05 ;
  cro:unit cro:Ratio .
