PREFIX cro: <https://customer-review-ontology.example/ontology#>

SELECT ?customer ?policy ?ratio ?maximum
WHERE {
  ?customer a cro:Customer ;
    cro:paymentTerms ?terms ;
    cro:pastDueAmount ?pastDue ;
    cro:arBalance ?balance .

  ?policy a cro:RatioPolicy ;
    cro:scopePaymentTerms ?terms ;
    cro:maxPastDueRatio ?maximum .

  FILTER (?balance > 0)
  BIND (?pastDue / ?balance AS ?ratio)
  FILTER (?ratio > ?maximum)
}
