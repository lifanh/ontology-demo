@prefix cro: <https://customer-review-ontology.example/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cro:CustomerShape a sh:NodeShape ;
  sh:targetClass cro:Customer ;
  sh:property [
    sh:path cro:customerNumber ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path cro:arBalance ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0 ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path cro:pastDueAmount ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0 ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path cro:paymentTerms ;
    sh:in ( cro:NET_15 cro:NET_30 cro:NET_45 cro:NET_60 ) ;
    sh:minCount 1 ; sh:maxCount 1
  ] .

cro:RatioPolicyShape a sh:NodeShape ;
  sh:targetClass cro:RatioPolicy ;
  sh:property [
    sh:path cro:maxPastDueRatio ;
    sh:datatype xsd:decimal ;
    sh:minExclusive 0 ; sh:maxInclusive 1 ;
    sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path cro:scopePaymentTerms ;
    sh:class cro:PaymentTerms ;
    sh:in ( cro:NET_15 cro:NET_30 cro:NET_45 cro:NET_60 ) ;
    sh:minCount 1 ; sh:maxCount 1
  ] .
