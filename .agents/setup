#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

printf '%s\n' 'Preparing the Axiom Policy Reasoner static demo...'

for required_file in index.html src/ui/app.js styles.css package.json slides/slides.md scripts/build-site.mjs; do
  if [[ ! -f "$required_file" ]]; then
    printf 'Required application file is missing: %s\n' "$required_file" >&2
    exit 1
  fi
done

export PATH="$HOME/.vite-plus/bin:$PATH"

if ! command -v vp >/dev/null 2>&1; then
  curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes bash
fi

npm clean-install --progress=false

printf '%s\n' 'Dependencies are installed; the static demo and Slidev deck are ready.'
