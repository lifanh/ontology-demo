#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export PATH="$HOME/.local/bin:$PATH"

if [[ ! -f index.html || ! -f slides/slides.md ]]; then
  printf '%s\n' 'Required demo or slide source is missing.' >&2
  exit 1
fi

if [[ ! -d node_modules || ! -x node_modules/.bin/slidev ]]; then
  npm ci
fi

printf '%s\n' 'No persistent services require repair; the demo and deck are ready.'
