{
  "name": "customer-review-ontology-showcase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "npm run test:unit && npm run check && npm run build && npm run test:site && npm run test:browser",
    "test:unit": "vp test --run tests/credit.test.mjs tests/server.test.mjs tests/ai.test.mjs tests/draft.test.mjs tests/review-explanation.test.mjs tests/policy-explanation.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "test:browser": "node --test tests/browser-state.test.mjs",
    "test:live-ai": "node scripts/live-ai-smoke.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "dev": "node scripts/dev.mjs",
    "slides:dev": "slidev slides/slides.md --base /slides/",
    "build": "node scripts/build-site.mjs",
    "start": "node server/node.js",
    "preview": "AI_ENABLED=false node server/node.js",
    "export:pdf": "node scripts/export-pdf.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@slidev/cli": "52.18.0",
    "@slidev/theme-default": "0.25.0",
    "@voidzero-dev/vite-plus-core": "^0.2.6",
    "playwright-chromium": "1.62.0",
    "vite-plus": "0.2.6",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "dependencies": {
    "@hono/node-server": "1.19.11",
    "ajv": "8.17.1",
    "hono": "4.12.32"
  }
}
